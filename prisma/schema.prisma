// Modelo de datos de la peluquería (un solo profesional).
// Los importes se guardan en céntimos (Int) para evitar errores de redondeo.
// Las fechas/horas de citas se guardan como "hora local del negocio" codificada en UTC
// (ver src/lib/time.ts) para que el cálculo de huecos no dependa de la zona del servidor.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  role         Role          @default(CLIENT)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  reviews      Review[]
  offers       UserOffer[]
  notifications Notification[]
}

model Treatment {
  id           String            @id @default(cuid())
  name         String
  description  String?
  durationMin  Int
  priceCents   Int
  active       Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  offers       TreatmentOffer[]
  userOffers   UserOffer[]
  items        AppointmentItem[]
}

/// Oferta de un tratamiento válida en un rango de fechas (ambos días incluidos).
model TreatmentOffer {
  id          String    @id @default(cuid())
  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  percent     Int
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  label       String?
  createdAt   DateTime  @default(now())

  @@index([treatmentId, startDate, endDate])
}

/// Oferta personal para un usuario. Si treatmentId es null, se aplica al total de la cita.
/// Es de un solo uso: al reservar con ella queda vinculada a la cita.
model UserOffer {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  treatmentId String?
  treatment   Treatment?   @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  percent     Int
  validUntil  DateTime?    @db.Date
  note        String?
  createdAt   DateTime     @default(now())
  appointmentId String?    @unique
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

/// Franja de trabajo semanal. Puede haber varias por día (mañana / tarde).
/// weekday: 0 = lunes ... 6 = domingo. Horas en minutos desde las 00:00.
model WorkingHour {
  id       String @id @default(cuid())
  weekday  Int
  startMin Int
  endMin   Int

  @@index([weekday])
}

/// Bloqueo puntual de agenda (vacaciones, médico, festivo...).
model TimeBlock {
  id     String   @id @default(cuid())
  start  DateTime
  end    DateTime
  reason String?
}

model Appointment {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  start         DateTime
  end           DateTime
  status        AppointmentStatus @default(CONFIRMED)
  subtotalCents Int
  discountCents Int
  totalCents    Int
  /// Descripción de cómo se calculó el descuento (p. ej. "Oferta personal 15% sobre el total").
  discountNote  String?
  notes         String?
  createdAt     DateTime          @default(now())
  cancelledAt   DateTime?
  items         AppointmentItem[]
  review        Review?
  userOffer     UserOffer?

  @@index([start])
  @@index([userId])
}

/// Tratamientos encadenados dentro de una cita, en orden. Se guarda una "foto" del
/// nombre/precio/duración para que cambios posteriores del catálogo no alteren el histórico.
model AppointmentItem {
  id              String      @id @default(cuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  treatmentId     String?
  treatment       Treatment?  @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  position        Int
  name            String
  durationMin     Int
  priceCents      Int
  discountPercent Int         @default(0)
  finalCents      Int
}

model Review {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  visible       Boolean     @default(true)
  reply         String?
  createdAt     DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/// Configuración general (clave/valor): nombre del negocio, paso de huecos, antelación mínima...
model Setting {
  key   String @id
  value String
}
