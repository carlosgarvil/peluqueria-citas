# Conexión a PostgreSQL (en docker compose ya viene configurada)
DATABASE_URL=postgresql://peluqueria:peluqueria@localhost:5432/peluqueria?schema=public
# Secreto para firmar la cookie de sesión (cámbialo en producción: openssl rand -base64 32)
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Zona horaria del negocio
BUSINESS_TZ=Europe/Madrid
